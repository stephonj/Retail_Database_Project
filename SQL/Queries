-- Retail Database Project: analysis queries
-- Run after schema.sql and sample_data.sql.

USE RetailSystem;

-- 1. Total sales by product
-- Question: How much revenue has each product generated?
SELECT
    Products.Name,
    SUM(OrderDetails.Quantity * OrderDetails.Price) AS TotalSales
FROM OrderDetails
JOIN Products ON OrderDetails.ProductID = Products.ProductID
GROUP BY Products.Name;

-- 2. Customer order history
-- Question: What has each customer purchased, and in what quantities?
SELECT
    Customers.FirstName,
    Customers.LastName,
    Products.Name AS Product,
    OrderDetails.Quantity
FROM Customers
JOIN Orders ON Customers.CustomerID = Orders.CustomerID
JOIN OrderDetails ON Orders.OrderID = OrderDetails.OrderID
JOIN Products ON OrderDetails.ProductID = Products.ProductID;

-- 3. Order summary (multi-table join)
-- Question: For each order, who bought it, which employee handled it, and what was the total?
SELECT
    Orders.OrderID,
    Orders.OrderDate,
    Customers.FirstName AS CustomerFirstName,
    Customers.LastName AS CustomerLastName,
    Employees.FirstName AS EmployeeFirstName,
    Employees.LastName AS EmployeeLastName,
    SUM(OrderDetails.Quantity * OrderDetails.Price) AS OrderTotal
FROM Orders
JOIN Customers ON Orders.CustomerID = Customers.CustomerID
JOIN Employees ON Orders.EmployeeID = Employees.EmployeeID
JOIN OrderDetails ON Orders.OrderID = OrderDetails.OrderID
GROUP BY
    Orders.OrderID,
    Orders.OrderDate,
    Customers.FirstName,
    Customers.LastName,
    Employees.FirstName,
    Employees.LastName;

-- 4. Customers with no orders (LEFT JOIN)
-- Question: Which customers have never placed an order?
SELECT
    Customers.FirstName,
    Customers.LastName,
    Customers.Email
FROM Customers
LEFT JOIN Orders ON Customers.CustomerID = Orders.CustomerID
WHERE Orders.OrderID IS NULL;

-- 5. Orders above the average order total (CTE)
-- Question: Which orders were larger than the average order?
WITH OrderTotals AS (
    SELECT
        Orders.OrderID,
        Orders.CustomerID,
        SUM(OrderDetails.Quantity * OrderDetails.Price) AS OrderTotal
    FROM Orders
    JOIN OrderDetails ON Orders.OrderID = OrderDetails.OrderID
    GROUP BY Orders.OrderID, Orders.CustomerID
)
SELECT
    Customers.FirstName,
    Customers.LastName,
    OrderTotals.OrderID,
    OrderTotals.OrderTotal
FROM OrderTotals
JOIN Customers ON OrderTotals.CustomerID = Customers.CustomerID
WHERE OrderTotals.OrderTotal > (SELECT AVG(OrderTotal) FROM OrderTotals);

-- 6. Product revenue ranking (window function)
-- Question: How do products rank by revenue?
-- With more products per category, add PARTITION BY Products.Category
-- inside OVER() to rank within each category instead.
SELECT
    Products.Name,
    Products.Category,
    SUM(OrderDetails.Quantity * OrderDetails.Price) AS TotalSales,
    RANK() OVER (ORDER BY SUM(OrderDetails.Quantity * OrderDetails.Price) DESC) AS RevenueRank
FROM OrderDetails
JOIN Products ON OrderDetails.ProductID = Products.ProductID
GROUP BY Products.Name, Products.Category;
